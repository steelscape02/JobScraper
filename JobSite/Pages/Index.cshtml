@page  
@model JobSite.Pages.IndexModel  
@{  
    ViewData["Title"] = "Jobs";  
}  
<link href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.css" rel="stylesheet" />


<div class="text-center">  
    <h1 class="display-4">Current Job Listings</h1>
    <div class ="buttonDiv">
        <button name="Filters" title="Filter Menu">Filters</button>
    </div>
    
    <div style="max-height: 500px; overflow-y: auto;">
        <table>
            <thead>
                <tr>  
                    <!-- Down Arrow: &darr; -->
                    <!-- Up Arrow:   &uarr; -->
                    <th>Job Title   <button type="button">-</button> </th>
                    <th>Company     <button type="button">-</button> </th>
                    <th>Location    <button type="button">-</button> </th>
                    <th>Wage        <button type="button">-</button> </th>
                    <th>Date Posted <button type="button">-</button> </th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @foreach (var row in Model.Jobs)
                {
                    <tr id="@row.Id">
                        <td><a href="@row.Url" target="_blank" rel="noreferrer noopener">@row.Title</a></td>
                        <td>@row.Company</td>
                        <td>@row.Location</td>
                        <td>@row.Wage</td>
                        <td id=@row.PostedOnRaw>@row.PostedOn</td> <!-- Provide epoch for simpler time comparison -->
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/jobHub.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.0/nouislider.min.js"></script>

<script>
    
</script>

