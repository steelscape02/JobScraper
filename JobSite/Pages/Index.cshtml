@page  
@model JobSite.Pages.IndexModel  
@{  
    ViewData["Title"] = "Home page";  
}  

<div class="text-center">  
    <h1 class="display-4">Welcome</h1>

    <div style="max-height: 500px; overflow-y: auto;">
        <table>
            <thead>
                <tr>  
                    <th>Job Title</th>
                    <th>Company</th>
                    <th>Location</th>
                    <th>Wage</th>
                    <th>Date Posted</th>
                    <th>Link</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                
            </tbody>
        </table>
    </div>
</div>

<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/jobHub.js"></script>
