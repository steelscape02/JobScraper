@page  
@model JobSite.Pages.IndexModel  
@{  
    ViewData["Title"] = "Jobs";  
}  

<div class="text-center">  
    <h1 class="display-4">Current Job Listings</h1>

    <div style="max-height: 500px; overflow-y: auto;">
        <table>
            <thead>
                <tr>  
                    <th>Job Title</th>
                    <th>Company</th>
                    <th>Location</th>
                    <th>Wage</th>
                    <th>Date Posted</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @foreach (var row in Model.Jobs)
                {
                    <tr id="@row.Id">
                        <td><a href="@row.Url" target="_blank" rel="noreferrer noopener">@row.Title</a></td>
                        <td>@row.Company</td>
                        <td>@row.Location</td>
                        <td>@row.Wage</td>
                        <td>@row.PostedOn</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script src="~/js/jobHub.js"></script>
